# Copy to .env and edit

PORT=4100

# ---- Production (see DEPLOY.md) ----
# NODE_ENV=production
# HOST=127.0.0.1        # listen only on localhost, behind nginx
# COOKIE_SECURE=true    # session cookie only over HTTPS
# API_RATE_PER_MIN=600  # per-IP API request limit
# SETUP_CODE=           # fixed first-run setup code (default: random, printed in the log)

# Each feed polls on its own timer (seconds). Unchanged feeds return a tiny 304,
# so fast polling is cheap. Google News and Investing.com use the slow interval.
POLL_FAST_SECONDS=20
POLL_SLOW_SECONDS=60

# Give up on a slow feed after this long (ms)
FETCH_TIMEOUT_MS=8000

# Ignore items older than this when ingesting (hours)
MAX_AGE_HOURS=48

# How long to keep items in data/news.json (days). The summary's "Last week (Mon–Sun)"
# needs up to 14 days; "Last 7 days" needs 7.
RETENTION_DAYS=14
# Max stories kept (newest win). ~1,000-1,500 arrive per day, so 15000 holds about 10-14 days.
MAX_ITEMS=15000

# ---- Users ----
# Sign-ins last this many days. Sessions are signed with a random secret saved in
# data/.session-secret (set SESSION_SECRET to use your own).
SESSION_DAYS=30
# SESSION_SECRET=

# ---- Telegram alerts (optional) ----
# One bot for everyone. Create it with @BotFather and paste the token here.
# Each user then adds their own chat ID (and alert level) in Settings.
TELEGRAM_BOT_TOKEN=
# Only used once, to pre-fill the first admin's chat ID
TELEGRAM_CHAT_ID=
ALERT_MIN_IMPACT=High

# ---- Market summary (optional AI brief) ----
# The "Summarize" button works without this. With a Claude API key it also writes
# a short AI market brief from the clubbed headlines (max 10 per user per hour).
# ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-haiku-5-5

# Telegram reminder this many minutes before High-impact calendar events
CALENDAR_REMIND_MINUTES=15
